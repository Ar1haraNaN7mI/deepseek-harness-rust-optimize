DEEPSEEK_API_KEY=sk-your-key-here
# Optional overrides
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-pro
# Generic OpenAI-compatible/local overrides (used by non-DeepSeek backends):
# DSH_LLM_API_KEY=...
# DSH_LLM_BACKEND=ollama
# For LM Studio use: DSH_LLM_BACKEND=lm_studio
# DSH_LLM_BASE_URL=http://127.0.0.1:11434/v1
# DSH_LLM_MODEL=qwen2.5:14b
# JSON object merged into OpenAI-compatible requests (reserved fields are protected):
# DSH_LLM_EXTRA_BODY={"cache_prompt":true}
# Comma-separated fallback base URLs, tried before streaming starts:
# DSH_LLM_FALLBACK_BASE_URLS=http://127.0.0.1:8080/v1,http://127.0.0.1:11434/v1
# Local loopback backends do not receive inherited hosted keys by default.
# Set only when the local gateway explicitly requires bearer auth:
# DSH_LLM_SEND_API_KEY=1
# DSH_MODEL_SIZE_B=14
# DSH_MODEL_OPTIMIZATION=auto

# Preferred (outer layer, no repo commit needed):
#   dsh config set-api-key <KEY>
#   # writes ~/.dsh-rust/credentials.env
# Or inside TUI: /apikey <KEY>
